# ==========================================
# KittyAI / KritiAI - Environment Variables
# ==========================================

# --- Local AI Orchestration (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
DEFAULT_LOCAL_MODEL=qwen2.5:latest
# Options: qwen2.5, deepseek-r1:8b, llama3.2, mistral, llava

# --- Cloud LLM Providers (Automatic Fallbacks & Multi-Model Switching) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Preferred default provider: 'ollama' | 'gemini' | 'openai' | 'groq'
AI_DEFAULT_PROVIDER=ollama

# --- Supabase Realtime Sync (Web Dashboard, Mobile & Desktop) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Python Sidecar (Local Automation & Agents) ---
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8000
NEXT_PUBLIC_SIDECAR_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SIDECAR_WS_URL=ws://127.0.0.1:8000/ws

# --- Plugins: Gmail SMTP & Email Automation ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Autonomous Meeting Delegate ---
MEETING_DELEGATE_NAME="KittyAI Delegate"
MEETING_HEADLESS=true
WHISPER_MODEL_SIZE=base
# Options: tiny, base, small, medium, large-v3

# --- OS Automation & Assist Mode ---
ASSIST_CAPTURE_INTERVAL_SEC=3
ASSIST_DIFF_THRESHOLD=0.08
ENABLE_FAILSAFE=true
